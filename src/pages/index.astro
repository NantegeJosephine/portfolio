---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { SITE, SKILL_GROUPS } from '../config';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title={`${SITE.name} — ${SITE.headline}`}>
  <section class="hero">
    <p class="kicker">{SITE.headline}</p>
    <h1>{SITE.name}</h1>
    <p class="subtitle">{SITE.subtitle}</p>
    <div class="cta-row">
      <a class="button" href="/projects">View projects</a>
      <a class="button ghost" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </section>

  <section>
    <h2>Toolkit</h2>
    <div class="skill-groups">
      {SKILL_GROUPS.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="chips">
            {group.skills.map((skill) => <span class="chip">{skill}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Featured work</h2>
    <div class="cards">
      {studies.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>
</Base>
