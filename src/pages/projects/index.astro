---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { SITE } from '../../config';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title={`Projects — ${SITE.name}`} description="Case studies across Python, Power BI and Excel analytics.">
  <h1>Projects</h1>
  <p class="subtitle">
    Case studies written as problem, data, method and outcome — with the
    evidence linked from each one.
  </p>
  <div class="cards">
    {studies.map((entry) => <CaseCard entry={entry} />)}
  </div>
</Base>
